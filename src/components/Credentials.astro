---
import SectionHead from './SectionHead.astro';
import { certifications, credentialsSection, education } from '../data/site';
---

<section id="credentials" class="mt-24 px-5 md:px-10">
  <div class="mx-auto max-w-[1360px]">
    <SectionHead
      number="05"
      eyebrow={credentialsSection.eyebrow}
      heading={credentialsSection.heading}
    />

    <div class="mt-8 flex flex-wrap border-t-2 border-[var(--color-divider)]">
      <div
        class="min-w-0 flex-[1_1_340px] py-7 md:border-r md:border-[var(--color-divider)] md:pr-8"
      >
        <h4 class="text-muted mt-0 mb-[18px] text-[13px] tracking-[0.1em] uppercase">
          Education
        </h4>
        <div class="flex flex-col gap-5">
          {
            education.map((item) => (
              <div>
                <div class="font-heading text-[18px] font-extrabold">
                  {item.degree}
                </div>
                <div class="mt-[3px] text-[13px]">{item.school}</div>
                <div class="text-muted mt-[6px] text-[13px]">{item.detail}</div>
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="min-w-0 flex-[1_1_340px] py-7 md:border-r md:border-[var(--color-divider)] md:px-8"
      >
        <h4 class="text-muted mt-0 mb-[18px] text-[13px] tracking-[0.1em] uppercase">
          Certifications
        </h4>
        <div class="flex flex-col text-[14px]">
          {
            certifications.map((cert, i) => (
              <div
                class:list={[
                  'py-[9px]',
                  i < certifications.length - 1 &&
                    'border-b border-[var(--color-divider)]',
                ]}
              >
                {cert}
              </div>
            ))
          }
        </div>
      </div>

      <div class="min-w-0 flex-[1_1_260px] py-7 md:pl-8">
        <h4 class="text-muted mt-0 mb-[18px] text-[13px] tracking-[0.1em] uppercase">
          {credentialsSection.beyondTitle}
        </h4>
        <p class="mt-0 mb-[14px] text-[14px] leading-[1.6]" set:html={credentialsSection.beyondBody} />
        <div class="border-t border-[var(--color-divider)] pt-[14px] text-[14px]">
          <span class="text-muted">Languages · </span>{credentialsSection.languages}
        </div>
      </div>
    </div>
  </div>
</section>
