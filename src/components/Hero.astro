---
import { Image } from 'astro:assets';
import portrait from '../assets/hussain-portrait.png';
import { flags, hero, person } from '../data/site';
---

<section id="top" class="px-5 md:px-10">
  <div class="mx-auto flex max-w-[1360px] flex-wrap gap-8 pt-14 md:gap-14 md:pt-[72px]">
    <div class="flex min-w-0 flex-[1_1_520px] flex-col items-start gap-7">
      {
        flags.showAvailability && (
          <div class="flex max-w-full items-center gap-[10px] border-2 border-accent px-3 py-[6px]">
            <span class="block size-2 flex-none bg-accent" />
            <span class="overflow-hidden font-heading text-[11px] font-extrabold tracking-[0.1em] text-ellipsis whitespace-nowrap text-accent-700 uppercase">
              {hero.availability}
            </span>
          </div>
        )
      }

      <h1
        class="m-0 max-w-[16ch] text-[clamp(46px,6.2vw,96px)] leading-[0.94] tracking-[-0.035em]"
      >
        {hero.headline}
      </h1>

      <p
        class="m-0 max-w-[52ch] text-[clamp(17px,1.5vw,22px)] leading-[1.45] text-pretty"
      >
        {hero.intro}
      </p>

      <div class="flex flex-wrap items-center gap-3">
        <a
          href={person.linkedin}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-[10px] bg-accent px-[22px] py-[15px] font-heading text-[15px] font-extrabold text-bg no-underline hover:bg-accent-600 hover:text-bg"
        >
          Start a conversation →
        </a>
        <a
          href={person.cv}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-[10px] border-2 border-text px-[22px] py-[13px] font-heading text-[15px] font-extrabold text-text no-underline hover:bg-text hover:text-bg"
        >
          Download CV (PDF)
        </a>
        <a
          href={person.github}
          target="_blank"
          rel="noopener"
          class="border-b-2 border-[var(--color-divider)] px-1 py-[13px] font-heading text-[15px] font-extrabold text-text no-underline hover:border-accent hover:text-accent"
        >
          GitHub
        </a>
      </div>

      <div class="mt-3 flex w-full flex-wrap border-t-2 border-[var(--color-divider)]">
        {
          hero.facts.map((fact, i) => (
            <div
              class:list={[
                'flex-[1_1_180px] py-4',
                i === 0 && 'pr-5 md:pl-0',
                i === 1 && 'px-0 md:px-5',
                i === 2 && 'md:pl-5',
                i < 2 && 'md:border-r md:border-[var(--color-divider)]',
              ]}
            >
              <div class="font-heading text-[11px] font-extrabold tracking-[0.1em] text-accent uppercase">
                {fact.label}
              </div>
              <div class="mt-1 text-[14px]">{fact.value}</div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="flex min-w-[280px] flex-[0_1_380px] flex-col">
      <div class="grayscale-photo w-full border-2 border-text">
        <Image
          src={portrait}
          alt={person.name}
          widths={[380, 760]}
          sizes="(min-width: 768px) 380px, 100vw"
          class="block aspect-3/4 w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="flex flex-col gap-[2px] border-2 border-t-0 border-text px-4 py-[14px]">
        <div class="font-heading text-[15px] font-extrabold">{person.name}</div>
        <div class="text-muted text-[12px] tracking-[0.04em]">{person.role}</div>
      </div>
    </div>
  </div>
</section>
