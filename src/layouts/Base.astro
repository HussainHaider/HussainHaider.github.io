---
import { Font } from 'astro:assets';
import { person, seo, stackGroups } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Keep 404 and other utility pages out of the sitemap and search results. */
  noindex?: boolean;
}

const { title = seo.title, description = seo.description, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(seo.ogImage, Astro.site).href;

// Structured data so search engines and LinkedIn read this as a person, not
// just a page. `knowsAbout` is derived from the stack section, so it can never
// drift from what the page actually claims.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  url: Astro.site?.href,
  image: ogImage,
  jobTitle: person.jobTitle,
  email: `mailto:${person.email}`,
  worksFor: { '@type': 'Organization', name: person.employer },
  address: {
    '@type': 'PostalAddress',
    addressLocality: person.city,
    addressCountry: person.countryCode,
  },
  sameAs: [person.linkedin, person.github],
  knowsAbout: stackGroups.flatMap((g) => g.items.split(' · ').map((s) => s.trim())),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={person.name} />
    <meta name="theme-color" content="#0f7a3d" />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${person.name} — ${person.role}`} />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Archivo, self-hosted and subset by Astro at build time. */}
    <Font cssVariable="--font-archivo" preload />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personSchema)}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
